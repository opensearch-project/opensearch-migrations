[
  {
    "TypeMappingSanitizationTransformerProvider": {
      "regexMappings": [
        {
          "sourceIndexPattern": "(test_e2e_0001_.*)",
          "sourceTypePattern": ".*",
          "targetIndexPattern": "$1_transformed"
        },
        {
          "sourceIndexPattern": "(.*)",
          "sourceTypePattern": "(.*)",
          "targetIndexPattern": "$1"
        }
      ],
      "sourceProperties": {
