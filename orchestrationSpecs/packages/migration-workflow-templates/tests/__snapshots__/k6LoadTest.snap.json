{
  "apiVersion": "argoproj.io/v1alpha1",
  "kind": "WorkflowTemplate",
  "metadata": {
    "name": "k6-load-test"
  },
  "spec": {
    "serviceAccountName": "argo-workflow-executor",
    "entrypoint": "run",
    "parallelism": 100,
    "arguments": {
      "parameters": [
        {
          "name": "scenario",
          "value": "ingest"
        },
        {
          "name": "configName",
          "value": "ingest-steady"
        },
        {
          "name": "targetUrl",
          "value": ""
        },
        {
          "name": "rate",
          "value": ""
        },
        {
          "name": "duration",
          "value": ""
        },
        {
          "name": "vus",
          "value": ""
        },
        {
          "name": "registryEnabled",
          "value": ""
        },
        {
          "name": "controlEnabled",
          "value": ""
        },
        {
          "name": "webdisUrl",
          "value": ""
        },
        {
          "name": "overrides",
          "value": ""
        },
        {
          "name": "extraArgs",
          "value": ""
        },
        {
          "name": "imageConfigMapName",
          "value": "migration-image-config"
        }
      ]
    },
    "templates": [
      {
        "name": "run",
        "inputs": {
          "parameters": [
            {
              "name": "imageK6Location",
              "valueFrom": {
                "configMapKeyRef": {
                  "name": "{{workflow.parameters.imageConfigMapName}}",
                  "key": "k6Image"
                }
              }
            },
            {
              "name": "imageK6PullPolicy",
              "valueFrom": {
                "configMapKeyRef": {
                  "name": "{{workflow.parameters.imageConfigMapName}}",
                  "key": "k6PullPolicy"
                }
              }
            }
          ]
        },
        "container": {
          "env": [
            {
              "name": "K6_OTEL_GRPC_EXPORTER_ENDPOINT",
              "value": "otel-collector:4317"
            },
            {
              "name": "K6_OTEL_GRPC_EXPORTER_INSECURE",
              "value": "true"
            },
            {
              "name": "SCRIPT_NAME",
              "value": "{{workflow.parameters.scenario}}"
            },
            {
              "name": "CONFIG_NAME",
              "value": "{{workflow.parameters.configName}}"
            },
            {
              "name": "TARGET_URL",
              "value": "{{workflow.parameters.targetUrl}}"
            },
            {
              "name": "RATE_OVERRIDE",
              "value": "{{workflow.parameters.rate}}"
            },
            {
              "name": "DURATION_OVERRIDE",
              "value": "{{workflow.parameters.duration}}"
            },
            {
              "name": "VUS_OVERRIDE",
              "value": "{{workflow.parameters.vus}}"
            },
            {
              "name": "OVERRIDES",
              "value": "{{workflow.parameters.overrides}}"
            },
            {
              "name": "EXTRA_ARGS",
              "value": "{{workflow.parameters.extraArgs}}"
            },
            {
              "name": "REGISTRY_ENABLED_PARAM",
              "value": "{{workflow.parameters.registryEnabled}}"
            },
            {
              "name": "CONTROL_ENABLED_PARAM",
              "value": "{{workflow.parameters.controlEnabled}}"
            },
            {
              "name": "WEBDIS_URL_PARAM",
              "value": "{{workflow.parameters.webdisUrl}}"
            }
          ],
          "image": "{{inputs.parameters.imageK6Location}}",
          "imagePullPolicy": "{{inputs.parameters.imageK6PullPolicy}}",
          "resources": {
            "requests": {
              "cpu": "500m",
              "memory": "512Mi"
            },
            "limits": {
              "cpu": "2",
              "memory": "1Gi"
            }
          },
          "command": [
            "/bin/sh",
            "-c"
          ],
          "args": [
            "\nset -eu\nCFG=\"/scripts/k6-config/${CONFIG_NAME}.env\"\nset -a\n# 1. baked-in preset = defaults (the preset files set CAPTURE_PROXY_URL / WEBDIS_URL / etc.)\nif [ -f \"$CFG\" ]; then . \"$CFG\"; else echo \"no such config: $CFG\" >&2; exit 2; fi\n# 2. named convenience overrides (empty = keep the preset)\n[ -n \"${DURATION_OVERRIDE:-}\" ] && DURATION=\"$DURATION_OVERRIDE\"\n[ -n \"${RATE_OVERRIDE:-}\" ]     && { INGEST_RATE=\"$RATE_OVERRIDE\"; SEARCH_RATE=\"$RATE_OVERRIDE\"; }\n[ -n \"${VUS_OVERRIDE:-}\" ]      && { INGEST_VUS=\"$VUS_OVERRIDE\"; SEARCH_VUS=\"$VUS_OVERRIDE\"; }\n# 3. dedicated params (empty = keep the preset). Applied AFTER sourcing so they win over it.\n[ -n \"${TARGET_URL:-}\" ]             && CAPTURE_PROXY_URL=\"$TARGET_URL\"\n[ -n \"${WEBDIS_URL_PARAM:-}\" ]       && WEBDIS_URL=\"$WEBDIS_URL_PARAM\"\n[ -n \"${REGISTRY_ENABLED_PARAM:-}\" ] && REGISTRY_ENABLED=\"$REGISTRY_ENABLED_PARAM\"\n[ -n \"${CONTROL_ENABLED_PARAM:-}\" ]  && CONTROL_ENABLED=\"$CONTROL_ENABLED_PARAM\"\n# 4. generic override bag (one KEY=VALUE per line) — applied last, so it wins over all.\n#    Here-doc (not a pipe) keeps the loop in this shell so exports persist to exec.\nwhile IFS= read -r kv; do\n  [ -n \"$kv\" ] && export \"$kv\"\ndone <<OVR\n${OVERRIDES}\nOVR\nset +a\necho \"k6: script=${SCRIPT_NAME} config=${CONFIG_NAME} target=${CAPTURE_PROXY_URL:-<unset>}\"\nexec k6 run --out=opentelemetry ${EXTRA_ARGS} \"/scripts/scenarios/${SCRIPT_NAME}.js\"\n"
          ]
        },
        "metadata": {
          "annotations": {
            "karpenter.sh/do-not-disrupt": "true"
          }
        },
        "outputs": {
          "parameters": []
        }
      }
    ]
  }
}
