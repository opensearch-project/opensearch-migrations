{
  "sourceClusters": {
    "source": {
      "version": "ES 7.10.2",
      "endpoint": "https://my-cluster.example.com:9200",
      "authConfig": { "basic": { "secretName": "source-creds" } },
      "snapshotInfo": {
        "repos": {
          "default": {
            "repoPathUri": "s3://snapshot-bucket",
            "awsRegion": "us-east-1"
          }
        },
        "snapshots": {
          "snap1": {
            "repoName": "default",
            "config": { "createSnapshotConfig": {} }
          }
        }
      }
    }
  },
  "targetClusters": {
    "target": { "endpoint": "http://target:9200" }
  },
  "snapshotMigrationConfigs": [
    {
      "fromSource": "source",
      "toTarget": "target",
      "perSnapshotConfig": {
        "snap1": [{ "metadataMigrationConfig": {} }]
      }
    }
  ]
}
