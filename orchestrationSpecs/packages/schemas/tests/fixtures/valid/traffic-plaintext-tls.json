{
  "sourceClusters": {
    "source": {
      "version": "ES 7.10.2",
      "endpoint": "http://source:9200"
    }
  },
  "targetClusters": {
    "target": {
      "endpoint": "http://target:9200"
    }
  },
  "snapshotMigrationConfigs": [],
  "traffic": {
    "kafkaClusters": {
      "default": {
        "autoCreate": {},
        "topics": {
          "proxy1": {}
        }
      }
    },
    "proxies": {
      "proxy1": {
        "source": "source",
        "kafka": "default",
        "proxyConfig": {
          "listenPort": 9201,
          "tls": {
            "mode": "plaintext"
          }
        },
        "kafkaTopic": "proxy1"
      }
    },
    "replayers": {
      "replayer1": {
        "fromCapturedTraffic": "proxy1",
        "toTarget": "target"
      }
    }
  }
}
