{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "moduleResolution": "bundler",
    "module": "Preserve",
    "lib": ["ES2024", "DOM"],
    "types": [],
    "customConditions": ["development"],
    "paths": {
      "@opensearch-migrations/schemas/browser": [
        "../schemas/src/browser.ts"
      ]
    },
    "disableSourceOfProjectReferenceRedirect": false,
    "skipLibCheck": true
  },
  "include": ["./src/**/*"],
  "exclude": ["node_modules", "dist", "tests", "**/*.test.ts"],
  "references": [
    { "path": "../schemas/tsconfig.json" }
  ]
}
