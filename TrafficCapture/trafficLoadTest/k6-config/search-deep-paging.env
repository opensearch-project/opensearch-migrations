# Deep-paging search load
#
# Activates the deep-paging fraction (5% of iterations run scroll or search_after
# sequences). Lower rate than search-steady because multi-step sequences are more
# expensive per iteration.

CAPTURE_PROXY_URL=https://capture-proxy:9201

SEARCH_RATE=20
SEARCH_VUS=20
SEARCH_MAX_VUS=80
DURATION=5m
SEED_DOC_COUNT=100000

# Deep paging ON — 5% of iterations run multi-step scroll or search_after sequences
DEEP_PAGING_ENABLED=true
PAGING_MODE=scroll
SCROLL_PAGES=5
SEARCH_AFTER_PAGES=5

CONNECTION_MODE=pinned
