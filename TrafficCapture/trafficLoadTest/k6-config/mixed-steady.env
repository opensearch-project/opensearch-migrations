# Steady mixed load
#
# Runs both the ingest stream and the search stream concurrently. The Redis ID
# ring connects them: ingest VUs register newly-created doc IDs; CONSISTENCY_FRACTION
# of search VUs draw from the ring to verify write-then-read consistency through
# the pipeline.

# Independent arrival rates for each stream
INGEST_RATE=30
SEARCH_RATE=20

# VU pools for each stream. Each VU holds one keep-alive TCP connection.
INGEST_VUS=15
INGEST_MAX_VUS=75
SEARCH_VUS=15
SEARCH_MAX_VUS=75

# Both streams run for the same duration.
DURATION=5m

# Ingest stream: documents per _bulk call and sequence fraction.
BULK_BATCH_SIZE=20
SEQUENCE_FRACTION=0.15

# Search stream: fraction of iterations that query a recently-ingested doc via
# the Redis ring buffer. The remaining (1 - CONSISTENCY_FRACTION) run the
# standard search mix (flat / agg / update / write).
CONSISTENCY_FRACTION=0.10

# Connection mode: "pinned" (keep-alive, default) or "spread" (Connection: close).
CONNECTION_MODE=pinned

# Expected document count in the seeded index (informs seed sampling in setup).
SEED_DOC_COUNT=100000

# Webdis HTTP-to-Redis proxy URL.
WEBDIS_URL=http://webdis:7379
REGISTRY_ENABLED=true

# Minimum number of IDs that must be in the Redis ring before search VUs start.
# Prevents elevated consistency-miss counts during the warmup window by delaying
# the search scenario by ceil(MIN_RING_FILL / (INGEST_RATE × (1−SEQ_FRACTION) × 0.3)) seconds.
# At defaults (30 req/s, SEQ_FRACTION=0.15): est. 7.6 IDs/s → MIN_RING_FILL=50 → ~7s delay.
# Set to 0 (default) to start both streams simultaneously.
MIN_RING_FILL=0
