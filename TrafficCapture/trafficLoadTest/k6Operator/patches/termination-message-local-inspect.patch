+func Test_LocalInitializerWritesCompactTerminationResult(t *testing.T) {
+	k6 := defaultTestRunForInitializer()
+	k6.Spec.Arguments = ""
+
+	job, err := NewInitializerJob(k6, "")
+	if err != nil {
+		t.Fatalf("NewInitializerJob errored: %v", err)
+	}
+
+	container := job.Spec.Template.Spec.Containers[0]
+	command := strings.Join(container.Command, " ")
+	for _, want := range []string{
+		`> "${inspect_output}"`,
+		`"maxVUs"`,
+		`tail -n 1`,
+		`{"success":true,"maxVUs":%s}`,
+		`> /dev/termination-log`,
+	} {
+		if !strings.Contains(command, want) {
+			t.Errorf("local initializer command should contain %q, got: %s", want, command)
+		}
+	}
+	if container.TerminationMessagePolicy != corev1.TerminationMessageReadFile {
+		t.Fatalf("unexpected termination message policy: %s", container.TerminationMessagePolicy)
+	}
+}
