+
+func localInspectOutputFromPod(pod *corev1.Pod) (cloud.InspectOutput, error) {
+	var inspectOutput cloud.InspectOutput
+	for _, status := range pod.Status.ContainerStatuses {
+		if status.Name != "k6" {
+			continue
+		}
+		if status.State.Terminated == nil {
+			return inspectOutput, errors.New("initializer k6 container has no terminated state")
+		}
+
+		message := strings.TrimSpace(status.State.Terminated.Message)
+		if message == "" {
+			return inspectOutput, errors.New("initializer k6 container has no termination message")
+		}
+
+		var result localInspectResult
+		if err := json.Unmarshal([]byte(message), &result); err != nil {
+			return inspectOutput, fmt.Errorf("invalid initializer termination message: %w", err)
+		}
+		if !result.Success {
+			return inspectOutput, errors.New("initializer termination message did not report success")
+		}
+
+		inspectOutput.MaxVUs = result.MaxVUs
+		return inspectOutput, nil
+	}
+
+	return inspectOutput, errors.New("initializer pod has no k6 container status")
+}
+
+func inspectLocalTestRun(ctx context.Context, log logr.Logger, k6 *v1alpha1.TestRun, c client.Client) (
+	inspectOutput cloud.InspectOutput, ready bool, returnErr error,
+) {
+	pod, ready, err := completedInitializerPod(ctx, log, k6, c)
+	if err != nil || !ready {
+		return inspectOutput, ready, err
+	}
+
+	inspectOutput, err = localInspectOutputFromPod(pod)
+	if err != nil {
+		log.Error(err, "unable to read local inspect result from initializer pod status")
+		return inspectOutput, false, err
+	}
+
+	return inspectOutput, true, nil
+}
+
+func inspectCloudTestRun(ctx context.Context, log logr.Logger, k6 *v1alpha1.TestRun, c client.Client) (
+	inspectOutput cloud.InspectOutput, ready bool, returnErr error,
+) {
+	pod, ready, err := completedInitializerPod(ctx, log, k6, c)
+	if err != nil || !ready {
+		return inspectOutput, ready, err
+	}
+
 	// Here we need to get the output of the pod
 	// pods/log is not currently supported by controller-runtime client and it is officially
 	// recommended to use REST client instead:
