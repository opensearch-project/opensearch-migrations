diff --git a/internal/controller/common_test.go b/internal/controller/common_test.go
new file mode 100644
index 0000000..b9c101d
--- /dev/null
+++ b/internal/controller/common_test.go
@@ -0,0 +1,106 @@
+package controllers
+
+import (
+	"context"
+	"testing"
+
+	"github.com/go-logr/logr"
+	"github.com/grafana/k6-operator/api/v1alpha1"
+	corev1 "k8s.io/api/core/v1"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"sigs.k8s.io/controller-runtime/pkg/client/fake"
+)
+
+func initializerPodWithTerminationMessage(message string) *corev1.Pod {
+	return &corev1.Pod{
+		Status: corev1.PodStatus{
+			ContainerStatuses: []corev1.ContainerStatus{
+				{
+					Name: "k6",
+					State: corev1.ContainerState{
+						Terminated: &corev1.ContainerStateTerminated{Message: message},
+					},
+				},
+			},
+		},
+	}
+}
+
+func TestLocalInspectOutputFromPod(t *testing.T) {
+	output, err := localInspectOutputFromPod(
+		initializerPodWithTerminationMessage(`{"success":true,"maxVUs":131072}`),
+	)
+	if err != nil {
+		t.Fatalf("localInspectOutputFromPod errored: %v", err)
+	}
+	if output.MaxVUs != 131072 {
+		t.Fatalf("MaxVUs = %d, want 131072", output.MaxVUs)
+	}
+}
+
+func TestInspectLocalTestRunReadsOnlyThePodObject(t *testing.T) {
+	pod := initializerPodWithTerminationMessage(`{"success":true,"maxVUs":2048}`)
+	pod.ObjectMeta = metav1.ObjectMeta{
+		Name:      "test-initializer-abc",
+		Namespace: "test",
+		Labels: map[string]string{
+			"app":      "k6",
+			"k6_cr":    "test",
+			"job-name": "test-initializer",
+		},
+	}
+	pod.Status.Phase = corev1.PodSucceeded
+	k6 := &v1alpha1.TestRun{ObjectMeta: metav1.ObjectMeta{Name: "test", Namespace: "test"}}
+	client := fake.NewClientBuilder().WithObjects(pod).Build()
+
+	output, ready, err := inspectLocalTestRun(context.Background(), logr.Discard(), k6, client)
+	if err != nil {
+		t.Fatalf("inspectLocalTestRun errored: %v", err)
+	}
+	if !ready {
+		t.Fatal("inspectLocalTestRun did not report a ready result")
+	}
+	if output.MaxVUs != 2048 {
+		t.Fatalf("MaxVUs = %d, want 2048", output.MaxVUs)
+	}
+}
+
+func TestLocalInspectOutputFromPodErrors(t *testing.T) {
+	tests := []struct {
+		name string
+		pod  *corev1.Pod
+	}{
+		{
+			name: "missing k6 container",
+			pod: &corev1.Pod{Status: corev1.PodStatus{
+				ContainerStatuses: []corev1.ContainerStatus{{Name: "other"}},
+			}},
+		},
+		{
+			name: "container not terminated",
+			pod: &corev1.Pod{Status: corev1.PodStatus{
+				ContainerStatuses: []corev1.ContainerStatus{{Name: "k6"}},
+			}},
+		},
+		{
+			name: "empty message",
+			pod:  initializerPodWithTerminationMessage(""),
+		},
+		{
+			name: "malformed json",
+			pod:  initializerPodWithTerminationMessage(`{"success":`),
+		},
+		{
+			name: "unsuccessful result",
+			pod:  initializerPodWithTerminationMessage(`{"success":false,"maxVUs":10}`),
+		},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			if _, err := localInspectOutputFromPod(test.pod); err == nil {
+				t.Fatal("localInspectOutputFromPod unexpectedly succeeded")
+			}
+		})
+	}
+}
