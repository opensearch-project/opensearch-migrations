+	}
+
+	command := strings.Join(job.Spec.Template.Spec.Containers[0].Command, " ")
+	if strings.Contains(command, "inspect_output=/tmp/k6-inspect.json") {
+		t.Fatalf("cloud initializer unexpectedly selected compact local output: %s", command)
+	}
+	if strings.Contains(command, "> /dev/termination-log") {
+		t.Fatalf("cloud initializer unexpectedly writes its inspect result to termination status: %s", command)
+	}
