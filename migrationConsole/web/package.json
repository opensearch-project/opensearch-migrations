{
  "name": "@opensearch-migrations/workflow-manage-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
