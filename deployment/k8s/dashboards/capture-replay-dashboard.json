        {
            "height": 1,
            "width": 24,
            "y": 35,
            "x": 0,
            "type": "text",
            "properties": {
                "markdown": "# Additional Replay Metrics\nCatch-up estimates project when the recently observed mean replay lag will reach the selected floor. They are not authoritative Kafka backlog drain estimates; broker consumer lag remains CLI-derived.",
                "background": "transparent"
            }
        },
        {
            "height": 6,
            "width": 12,
            "y": 48,
            "x": 0,
            "type": "metric",
            "properties": {
                "metrics": [
                    [ "OpenSearchMigrations", "lagBetweenSourceAndTargetRequests", "qualifier", "MA_QUALIFIER", "OTelLib", "replayer", { "id": "lag_avg_ms", "region": "REGION", "label": "lag_avg_ms", "visible": false } ],
                    [ { "expression": "lag_avg_ms/1000", "label": "lag_avg_sec", "id": "lag_avg_sec", "region": "REGION", "stat": "Average", "period": 300, "visible": false } ],
                    [ { "expression": "-1*RATE(lag_avg_sec)", "label": "lag_reduction_rate", "id": "lag_reduction_rate", "region": "REGION", "period": 300, "visible": false } ],
                    [ { "expression": "IF(lag_avg_sec>CATCHUP_FLOOR_SECONDS, IF(lag_reduction_rate>0.01, ((lag_avg_sec-CATCHUP_FLOOR_SECONDS)/3600)/lag_reduction_rate, 0/0), 0/0)", "label": "catch-up hours", "id": "catchup_hours", "region": "REGION", "period": 300 } ]
                ],
                "view": "singleValue",
                "title": "Mean-lag catch-up ETA to CATCHUP_FLOOR_SECONDS-second floor",
                "region": "REGION",
                "yAxis": {
                    "left": {
                        "label": "Speedup Factor",
                        "min": 0,
                        "showUnits": false
                    }
                },
                "stat": "Average",
                "period": 300,
                "setPeriodToTimeRange": false,
                "singleValueFullPrecision": false,
                "sparkline": true,
                "stacked": false,
                "liveData": false
            }
        },
        {
            "height": 6,
            "width": 12,
            "y": 48,
            "x": 12,
            "type": "metric",
            "properties": {
                "metrics": [
                    [ "OpenSearchMigrations", "lagBetweenSourceAndTargetRequests", "qualifier", "MA_QUALIFIER", "OTelLib", "replayer", { "id": "lag_avg_ms_ts", "region": "REGION", "label": "lag_avg_ms", "visible": false } ],
                    [ { "expression": "lag_avg_ms_ts/1000", "label": "lag_avg_sec", "id": "lag_avg_sec_ts", "region": "REGION", "stat": "Average", "period": 300, "visible": false } ],
                    [ { "expression": "-1*RATE(lag_avg_sec_ts)", "label": "lag_reduction_rate", "id": "lag_reduction_rate_ts", "region": "REGION", "period": 300, "visible": false } ],
                    [ { "expression": "IF(lag_avg_sec_ts>CATCHUP_FLOOR_SECONDS, IF(lag_reduction_rate_ts>0.01, ((lag_avg_sec_ts-CATCHUP_FLOOR_SECONDS)/3600)/lag_reduction_rate_ts, 0/0), 0/0)", "label": "catch-up hours", "id": "catchup_hours_ts", "region": "REGION", "period": 300 } ]
                ],
                "view": "timeSeries",
                "title": "Historical mean-lag catch-up ETA to CATCHUP_FLOOR_SECONDS-second floor",
                "region": "REGION",
                "yAxis": {
