                "metrics": [
                    [ "OpenSearchMigrations", "lagBetweenSourceAndTargetRequests", "qualifier", "MA_QUALIFIER", "OTelLib", "replayer", { "id": "m4", "region": "REGION", "label": "Avg", "color": "#dbdb8d", "visible": false } ],
                    [ { "expression": "m4/1000", "label": "Mean replay lag", "id": "e2", "region": "REGION", "color": "#9edae5", "period": 60 } ],
                    [ { "expression": "TIME_SERIES(CATCHUP_FLOOR_SECONDS)", "label": "Selected catch-up floor", "id": "e3", "region": "REGION", "color": "#ff7f0e", "period": 60 } ]
                ],
                "view": "timeSeries",
                "title": "Mean replay lag and CATCHUP_FLOOR_SECONDS-second catch-up floor",
                "region": "REGION",
                "yAxis": {
                    "left": {
                        "label": "Lag (seconds)",
                        "showUnits": false
                    }
                },
                "stat": "Average",
                "period": 60,
                "liveData": true
            }
        },
        {
            "height": 7,
            "width": 24,
            "y": 14,
            "x": 0,
            "type": "metric",
            "properties": {
                "metrics": [
                    [ { "expression": "SEARCH('{OpenSearchMigrations,OTelLib, method, qualifier, sourceStatusCode, statusCodesMatch, targetStatusCode} qualifier=\"MA_QUALIFIER\" statusCodesMatch=\"true\"', 'Sum', 60)", "id": "e2", "period": 60, "region": "REGION", "label": "${PROP('Dim.method')} Status code class: ${PROP('Dim.sourceStatusCode')}" } ]
                ],
                "sparkline": true,
                "view": "timeSeries",
                "region": "REGION",
                "period": 60,
                "stat": "Sum",
                "title": "Replayer Status Code Matches ",
