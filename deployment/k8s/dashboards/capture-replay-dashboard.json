            "properties": {
                "metrics": [
                    [ { "expression": "SUM(SEARCH('{OpenSearchMigrations,OTelLib,qualifier} MetricName=\"targetAttemptPermitsActive\" OTelLib=\"replayer\" qualifier=\"MA_QUALIFIER\"', 'Maximum', 60))", "id": "e1", "label": "Active target permits", "region": "REGION" } ],
