                    [ { "expression": "MAX(SEARCH('{OpenSearchMigrations,OTelLib,qualifier} MetricName=\"replayOldestKafkaRecordAge\" OTelLib=\"replayer\" qualifier=\"MA_QUALIFIER\"', 'Maximum', 60))", "id": "e2", "label": "Oldest Kafka record age (ms)", "region": "REGION" } ],
                    [ { "expression": "SUM(SEARCH('{OpenSearchMigrations,OTelLib,qualifier} MetricName=\"replayActiveOwnerOperations\" OTelLib=\"replayer\" qualifier=\"MA_QUALIFIER\"', 'Maximum', 60))", "id": "e3", "label": "Owner operations", "region": "REGION" } ],
                    [ { "expression": "SUM(SEARCH('{OpenSearchMigrations,OTelLib,qualifier} MetricName=\"replayLongRunningOwnerOperations\" OTelLib=\"replayer\" qualifier=\"MA_QUALIFIER\"', 'Maximum', 60))", "id": "e4", "label": "Long-running operations", "region": "REGION" } ]
