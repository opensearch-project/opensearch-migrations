                    [ { "expression": "SUM(SEARCH('{OpenSearchMigrations,OTelLib,qualifier,recordKind} MetricName=\"capturePublishingRecordsAwaitingAcknowledgement\" OTelLib=\"captureProxy\" qualifier=\"MA_QUALIFIER\"', 'Maximum', 60))", "id": "e1", "label": "Records awaiting acknowledgement", "region": "REGION" } ],
                    [ { "expression": "SUM(SEARCH('{OpenSearchMigrations,OTelLib,qualifier} MetricName=\"captureHeartbeatDeadlineViolations\" OTelLib=\"captureProxy\" qualifier=\"MA_QUALIFIER\"', 'Sum', 60))", "id": "e2", "label": "Heartbeat deadline violations", "region": "REGION" } ],
                    [ { "expression": "SUM(SEARCH('{OpenSearchMigrations,OTelLib,qualifier,reason} MetricName=\"capturePublisherFailures\" OTelLib=\"captureProxy\" qualifier=\"MA_QUALIFIER\"', 'Sum', 60))", "id": "e3", "label": "Publisher failures", "region": "REGION" } ],
                    [ { "expression": "SUM(SEARCH('{OpenSearchMigrations,OTelLib,captureActivationId,mode,processId,qualifier,sourceForwardingContinued} MetricName=\"captureGapActive\" OTelLib=\"captureProxy\" qualifier=\"MA_QUALIFIER\"', 'Maximum', 60))", "id": "e4", "label": "Capture gap active", "region": "REGION" } ]
