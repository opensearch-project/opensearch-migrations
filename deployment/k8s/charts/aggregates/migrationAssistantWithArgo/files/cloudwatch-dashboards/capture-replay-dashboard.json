            "properties": {
                "metrics": [
                    [ { "expression": "FILL(m2, 0)", "label": "Kafka Commits", "id": "e1", "region": "REGION", "period": 300 } ],
                    [ "OpenSearchMigrations", "kafkaCommitCount", "qualifier", "MA_QUALIFIER", "OTelLib", "replayer", { "id": "m2", "region": "REGION", "visible": false } ]
                ],
                "sparkline": true,
                "view": "timeSeries",
                "region": "REGION",
                "period": 300,
                "stat": "Sum",
                "title": "Replayer Kafka Commit Activity",
                "stacked": false,
                "liveData": false,
                "yAxis": {
                    "left": {
                        "label": "Count",
                        "min": 0,
                        "showUnits": false
                    }
                }
            }
        },
        {
            "height": 6,
            "width": 12,
            "y": 36,
            "x": 12,
            "type": "metric",
            "properties": {
                "metrics": [
                    [ { "expression": "m1 / 1048576", "id": "e1", "region": "REGION", "label": "Average pod" } ],
                    [ { "expression": "m2 / 1048576", "id": "e2", "region": "REGION", "label": "Hottest pod" } ],
                    [ "OpenSearchMigrations", "container_memory_working_set_bytes", "container", "replayer", "namespace", "ma", { "id": "m1", "stat": "Average", "region": "REGION", "visible": false } ],
                    [ "OpenSearchMigrations", "container_memory_working_set_bytes", "container", "replayer", "namespace", "ma", { "id": "m2", "stat": "Maximum", "region": "REGION", "visible": false } ]
                ],
                "view": "timeSeries",
