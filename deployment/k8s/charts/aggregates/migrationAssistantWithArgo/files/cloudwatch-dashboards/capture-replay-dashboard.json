            "y": 55,
            "x": 0,
            "type": "text",
            "properties": {
                "markdown": "# Capture and Replay Operational Health",
                "background": "transparent"
            }
        },
        {
            "height": 6,
            "width": 12,
            "y": 56,
            "x": 0,
            "type": "metric",
            "properties": {
                "metrics": [
                    [ { "expression": "SUM(SEARCH('{OpenSearchMigrations,OTelLib,qualifier,recordKind} MetricName=\"capturePublishingRecordsAccepted\" OTelLib=\"captureProxy\" qualifier=\"MA_QUALIFIER\"', 'Sum', 60)) / 60", "id": "e1", "label": "Published records/s", "region": "REGION" } ],
                    [ { "expression": "SUM(SEARCH('{OpenSearchMigrations,OTelLib,qualifier,recordKind} MetricName=\"capturePublishingBytesAccepted\" OTelLib=\"captureProxy\" qualifier=\"MA_QUALIFIER\"', 'Sum', 60)) / 60", "id": "e2", "label": "Published bytes/s", "region": "REGION" } ],
                    [ { "expression": "SUM(SEARCH('{OpenSearchMigrations,OTelLib,qualifier,recordKind} MetricName=\"capturePublishingRecordsAwaitingAcknowledgement\" OTelLib=\"captureProxy\" qualifier=\"MA_QUALIFIER\"', 'Maximum', 60))", "id": "e3", "label": "Records awaiting acknowledgement", "region": "REGION" } ],
                    [ { "expression": "SUM(SEARCH('{OpenSearchMigrations,OTelLib,qualifier,recordKind} MetricName=\"capturePublishingBytesAwaitingAcknowledgement\" OTelLib=\"captureProxy\" qualifier=\"MA_QUALIFIER\"', 'Maximum', 60))", "id": "e11", "label": "Bytes awaiting acknowledgement", "region": "REGION", "yAxis": "right" } ],
                    [ { "expression": "SUM(SEARCH('{OpenSearchMigrations,OTelLib,outcome,qualifier,recordKind} MetricName=\"capturePublishingCompletions\" OTelLib=\"captureProxy\" qualifier=\"MA_QUALIFIER\" outcome=\"acknowledged\"', 'Sum', 60)) / 60", "id": "e12", "label": "Acknowledged publications/s", "region": "REGION" } ],
                    [ { "expression": "SUM(SEARCH('{OpenSearchMigrations,OTelLib,outcome,qualifier,recordKind} MetricName=\"capturePublishingCompletions\" OTelLib=\"captureProxy\" qualifier=\"MA_QUALIFIER\" outcome=\"failed\"', 'Sum', 60)) / 60", "id": "e13", "label": "Failed publications/s", "region": "REGION" } ],
                    [ { "expression": "SUM(SEARCH('{OpenSearchMigrations,OTelLib,qualifier} MetricName=\"captureWritersActive\" OTelLib=\"captureProxy\" qualifier=\"MA_QUALIFIER\"', 'Maximum', 60))", "id": "e4", "label": "Active writers", "region": "REGION" } ],
                    [ { "expression": "SUM(SEARCH('{OpenSearchMigrations,OTelLib,qualifier} MetricName=\"captureWritersDraining\" OTelLib=\"captureProxy\" qualifier=\"MA_QUALIFIER\"', 'Maximum', 60))", "id": "e5", "label": "Draining writers", "region": "REGION" } ],
                    [ { "expression": "SUM(SEARCH('{OpenSearchMigrations,OTelLib,qualifier} MetricName=\"captureConnectionsActive\" OTelLib=\"captureProxy\" qualifier=\"MA_QUALIFIER\"', 'Maximum', 60))", "id": "e6", "label": "Active connections", "region": "REGION" } ],
                    [ { "expression": "SUM(SEARCH('{OpenSearchMigrations,OTelLib,qualifier} MetricName=\"captureHeartbeatDeadlineViolations\" OTelLib=\"captureProxy\" qualifier=\"MA_QUALIFIER\"', 'Sum', 60))", "id": "e7", "label": "Heartbeat deadline violations", "region": "REGION" } ],
                    [ { "expression": "SUM(SEARCH('{OpenSearchMigrations,OTelLib,qualifier,reason} MetricName=\"capturePublisherFailures\" OTelLib=\"captureProxy\" qualifier=\"MA_QUALIFIER\"', 'Sum', 60))", "id": "e8", "label": "Publisher failures", "region": "REGION" } ],
