                    [ { "expression": "SUM(SEARCH('{OpenSearchMigrations,OTelLib,qualifier} MetricName=\"replayActiveOwnerOperations\" OTelLib=\"replayer\" qualifier=\"MA_QUALIFIER\"', 'Maximum', 60))", "id": "e2", "label": "Owner operations", "region": "REGION" } ],
                    [ { "expression": "SUM(SEARCH('{OpenSearchMigrations,OTelLib,qualifier} MetricName=\"replayLongRunningOwnerOperations\" OTelLib=\"replayer\" qualifier=\"MA_QUALIFIER\"', 'Maximum', 60))", "id": "e3", "label": "Long-running operations", "region": "REGION" } ],
