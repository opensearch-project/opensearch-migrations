        },
        {
            "height": 6,
            "width": 12,
            "y": 36,
            "x": 0,
            "type": "metric",
            "properties": {
                "metrics": [
                    [ { "expression": "m1 / 60", "label": "Fleet CPU cores", "id": "e1", "region": "REGION" } ],
                    [ "OpenSearchMigrations", "container_cpu_usage_seconds_total", "container", "replayer", "namespace", "ma", { "id": "m1", "stat": "Sum", "region": "REGION", "visible": false } ]
                ],
                "view": "timeSeries",
                "stacked": false,
                "title": "Replayer CPU Utilization (Fleet)",
                "region": "REGION",
                "period": 60,
                "yAxis": {
                    "left": {
                        "label": "CPU (cores)",
                        "min": 0,
                        "showUnits": false
                    }
