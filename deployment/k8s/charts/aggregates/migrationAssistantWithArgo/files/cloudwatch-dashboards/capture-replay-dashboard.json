{
    "variables": [
        {
            "type": "property",
            "property": "region",
            "inputType": "input",
            "id": "REGION",
            "label": "Region",
            "defaultValue": "placeholder-region",
            "visible": false
        },
        {
            "type": "pattern",
            "pattern": "MA_STAGE",
            "inputType": "input",
            "id": "MA_STAGE",
            "label": "Migration Stage",
            "defaultValue": "placeholder-stage",
            "visible": false
        },
        {
            "type": "pattern",
            "pattern": "MA_QUALIFIER",
            "inputType": "input",
            "id": "MA_QUALIFIER",
            "label": "Migration Qualifier",
            "defaultValue": "placeholder-qualifier",
            "visible": false
        },
        {
            "type": "pattern",
            "pattern": "CATCHUP_FLOOR_SECONDS",
            "inputType": "select",
            "id": "CATCHUP_FLOOR_SECONDS",
            "label": "Catch-up lag floor",
            "defaultValue": "5",
            "values": [
                { "label": "1 second", "value": "1" },
                { "label": "5 seconds", "value": "5" },
                { "label": "1 minute", "value": "60" }
            ],
            "visible": true
        },
        {
            "type": "property",
            "property": "LoadBalancer",
            "inputType": "select",
            "id": "NLB_NAME",
            "label": "Capture Proxy NLB",
            "search": "{AWS/NetworkELB,LoadBalancer} MetricName=\"ProcessedBytes\"",
            "populateFrom": "LoadBalancer",
            "defaultValue": "",
            "visible": true
        }
    ],
    "widgets": [
        {
            "height": 1,
            "width": 24,
            "y": 0,
            "x": 0,
            "type": "text",
            "properties": {
                "markdown": "# Bytes",
                "background": "transparent"
            }
        },
        {
            "height": 6,
            "width": 11,
            "y": 1,
            "x": 0,
            "type": "metric",
            "properties": {
                "metrics": [
                    [ "OpenSearchMigrations", "bytesRead", "qualifier", "MA_QUALIFIER", "OTelLib", "captureProxy", { "label": "Response Bytes", "region": "REGION", "id": "c1", "visible": false } ],
                    [ "OpenSearchMigrations", "bytesWritten", "qualifier", "MA_QUALIFIER", { "label": "Request Bytes", "region": "REGION", "id": "c2", "visible": false } ],
                    [ { "expression": "(c1 + c2) / 1048576 / PERIOD(c1)", "label": "Proxy", "id": "e1", "region": "REGION", "color": "#7f7f7f" } ],
                    [ "AWS/NetworkELB", "ProcessedBytes", "LoadBalancer", "NLB_NAME", { "id": "n1", "period": 60, "region": "REGION", "visible": false, "label": "NLB Bytes per Period" } ],
                    [ { "expression": "n1/1048576 / PERIOD(n1)", "label": "NLB", "id": "n2", "region": "REGION" } ]
                ],
                "view": "timeSeries",
                "stacked": false,
                "region": "REGION",
                "stat": "Sum",
                "period": 60,
                "title": "Proxy Traffic as observed by various sources (MBps)",
                "yAxis": {
                    "left": {
                        "min": 0,
                        "label": "MBps",
                        "showUnits": false
                    }
                }
            }
        },
        {
            "height": 1,
            "width": 24,
            "y": 28,
            "x": 0,
            "type": "text",
            "properties": {
                "markdown": "# Kafka Integration",
                "background": "transparent"
            }
        },
        {
            "height": 6,
            "width": 24,
