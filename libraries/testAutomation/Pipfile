[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
# urllib3 is a transitive dependency, pinned here for CVE management (CVE-2025-66471, CVE-2025-66418)
urllib3 = ">=2.7.0"
kubernetes = ">=36.0.2"
argparse = "*"
tabulate = "*"
# Used by resource_tag_verifier to read tags straight from the AWS APIs.
boto3 = "*"

[requires]
python_version = "3.11"

[scripts]
app = "python3 testAutomation/test_runner.py"
# Standalone so it can be re-run against an existing deployment without re-running a migration:
#   pipenv run verify-tags --expect-tags 'K=V,K2=V2' --region us-east-1 \
#     --kube-context <ctx> --stack-name <stack>
verify-tags = "python3 testAutomation/resource_tag_verifier.py"
test = "coverage run -m pytest tests/"
coverage = "coverage"

[dev-packages]
pytest = "*"
coverage = "*"
